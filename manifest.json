{
  "manifest_version": 3,
  "name": "Steady Keys",
  "version": "0.1.0",
  "description": "A small Vimium-style keyboard navigator with fixed shortcuts.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Steady Keys", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
